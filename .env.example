# Copy this file to .env. Never commit .env or real API keys.

# Answer generation: ollama, openai, or gemini
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5vl:7b
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434

# Optional figure descriptions during upload processing. Leave empty to skip vision.
VISION_PROVIDER=ollama
VISION_MODEL=qwen2.5vl:7b
VISION_API_KEY=
VISION_BASE_URL=http://localhost:11434

# Embeddings — keep compatible with your existing index
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Larger batches reduce request overhead. Lower this if local memory is constrained.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434

# Retrieval is restricted to the selected document's isolated Qdrant collection.
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.15

# Frontend API URL (set as a frontend build variable, never put secrets here).
VITE_API_BASE_URL=http://localhost:8000/api
